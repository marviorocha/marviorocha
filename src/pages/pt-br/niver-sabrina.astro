<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feliz Aniversário, Sabrina! 🍎</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Patrick+Hand&family=Nunito:wght@400;600;700;800&display=swap');

    :root {
      --board: #1e3a2f;
      --board-dark: #142720;
      --board-light: #274a3b;
      --chalk-white: #f6f1e6;
      --chalk-yellow: #f0cf6c;
      --chalk-pink: #f2a4b0;
      --chalk-blue: #9fd3e8;
      --wood: #7a4a26;
      --wood-dark: #5a3319;
      --wood-light: #96603a;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 20% 10%, rgba(255, 255, 255, 0.03), transparent 40%),
        radial-gradient(ellipse at 80% 90%, rgba(255, 255, 255, 0.03), transparent 40%),
        var(--board);
      font-family: 'Nunito', sans-serif;
      color: var(--chalk-white);
      overflow-x: hidden;
      position: relative;
    }

    /* chalk dust texture overlay */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        radial-gradient(1px 1px at 10% 20%, rgba(255, 255, 255, .15) 0, transparent 50%),
        radial-gradient(1px 1px at 80% 40%, rgba(255, 255, 255, .1) 0, transparent 50%),
        radial-gradient(1px 1px at 60% 80%, rgba(255, 255, 255, .12) 0, transparent 50%),
        radial-gradient(1px 1px at 30% 65%, rgba(255, 255, 255, .1) 0, transparent 50%),
        radial-gradient(1px 1px at 45% 15%, rgba(255, 255, 255, .08) 0, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    .wood-frame {
      position: relative;
      max-width: 720px;
      margin: 24px auto;
      padding: 14px;
      background:
        repeating-linear-gradient(90deg, var(--wood-light) 0px, var(--wood) 6px, var(--wood-dark) 12px);
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, .5), inset 0 0 0 4px rgba(0, 0, 0, .2);
    }

    .board-inner {
      position: relative;
      background: var(--board);
      border-radius: 10px;
      min-height: 640px;
      padding: 36px 28px 30px;
      overflow: hidden;
      box-shadow: inset 0 0 60px rgba(0, 0, 0, .45), inset 0 0 0 2px rgba(255, 255, 255, .03);
    }

    .screen {
      display: none;
      position: relative;
      z-index: 2;
      flex-direction: column;
      align-items: center;
      text-align: center;
      animation: fadein .6s ease;
    }

    .screen.active {
      display: flex;
    }

    @keyframes fadein {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ---------- shared chalk text styles ---------- */
    .eyebrow {
      font-family: 'Patrick Hand', cursive;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-size: 13px;
      color: var(--chalk-blue);
      opacity: .85;
      margin-bottom: 6px;
    }

    h1.chalk-title {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: clamp(40px, 9vw, 68px);
      line-height: 1.05;
      margin: 4px 0 14px;
      color: var(--chalk-white);
      text-shadow: 0 0 1px rgba(255, 255, 255, .4), 0 0 22px rgba(246, 241, 230, .15);
    }

    .subtitle {
      font-family: 'Nunito', sans-serif;
      font-size: 15.5px;
      line-height: 1.6;
      color: rgba(246, 241, 230, .85);
      max-width: 440px;
      margin: 0 auto 26px;
    }

    .chalk-btn {
      font-family: 'Patrick Hand', cursive;
      font-size: 20px;
      background: transparent;
      color: var(--chalk-white);
      border: 2.5px dashed rgba(246, 241, 230, .7);
      border-radius: 14px 130px 14px 130px / 130px 14px 130px 14px;
      padding: 12px 30px;
      cursor: pointer;
      transition: transform .15s ease, background .2s ease, color .2s ease;
      letter-spacing: .5px;
    }

    .chalk-btn:hover,
    .chalk-btn:focus-visible {
      background: rgba(246, 241, 230, .1);
      transform: translateY(-2px) rotate(-0.5deg);
      outline: none;
    }

    .chalk-btn:active {
      transform: translateY(0) scale(.98);
    }

    /* floating doodles on intro */
    .doodles {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
    }

    .doodles span {
      position: absolute;
      font-size: 26px;
      opacity: .35;
      animation: floaty 6s ease-in-out infinite;
      filter: drop-shadow(0 0 6px rgba(255, 255, 255, .1));
    }

    @keyframes floaty {

      0%,
      100% {
        transform: translateY(0) rotate(-4deg);
      }

      50% {
        transform: translateY(-14px) rotate(4deg);
      }
    }

    /* ---------- game screen ---------- */
    .stats {
      display: flex;
      gap: 26px;
      font-family: 'Patrick Hand', cursive;
      font-size: 17px;
      margin-bottom: 18px;
      color: var(--chalk-yellow);
    }

    .stats b {
      color: var(--chalk-white);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      width: 100%;
      max-width: 460px;
      margin: 0 auto;
      perspective: 900px;
    }

    .card {
      aspect-ratio: 1 / 1;
      position: relative;
      cursor: pointer;
    }

    .card-inner {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform .5s cubic-bezier(.2, .9, .3, 1.1);
    }

    .card.flipped .card-inner,
    .card.matched .card-inner {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      backface-visibility: hidden;
      border-radius: 14px 40px 14px 40px / 40px 14px 40px 14px;
      filter: url(#roughen);
    }

    .card-back {
      background: var(--board-light);
      border: 2.5px dashed rgba(246, 241, 230, .55);
      font-size: 22px;
      color: rgba(246, 241, 230, .5);
    }

    .card-front {
      background: rgba(246, 241, 230, .08);
      border: 2.5px solid rgba(246, 241, 230, .75);
      transform: rotateY(180deg);
      font-size: clamp(24px, 6vw, 32px);
    }

    .card.matched .card-front {
      background: rgba(159, 211, 232, .15);
      border-color: var(--chalk-blue);
      box-shadow: 0 0 18px rgba(159, 211, 232, .35);
    }

    .card:focus-visible .card-face {
      outline: 2px dashed var(--chalk-yellow);
      outline-offset: 3px;
    }

    .card.matched {
      cursor: default;
    }

    .hint {
      margin-top: 18px;
      font-family: 'Patrick Hand', cursive;
      font-size: 14px;
      color: rgba(246, 241, 230, .5);
    }

    /* ---------- celebration screen ---------- */
    .confetti-layer {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 1;
    }

    .confetti {
      position: absolute;
      top: -20px;
      border-radius: 2px;
      opacity: .9;
      animation: fall linear forwards;
    }

    @keyframes fall {
      to {
        transform: translateY(680px) rotate(400deg);
        opacity: 0;
      }
    }

    .cake {
      font-size: 54px;
      margin-bottom: 6px;
      animation: bounce 1.8s ease-in-out infinite;
    }

    @keyframes bounce {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-8px);
      }
    }

    .message-box {
      font-family: 'Nunito', sans-serif;
      font-size: 1.25rem;
      line-height: 1.75;
      color: rgba(246, 241, 230, .92);
      background: rgba(246, 241, 230, .06);
      border: 2px dashed rgba(246, 241, 230, .4);
      border-radius: 18px 55px 18px 55px / 55px 18px 55px 18px;
      padding: 24px 26px;
      max-width: 460px;
      margin: 6px auto 24px;
      text-align: left;
    }

    .signature_over {
      font-family: 'Nunito', cursive;
      font-size: 20px;
      color: var(--chalk-yellow);
      text-align: right;
      margin-top: 11px;
    }

    .signature {
      font-family: 'Caveat', cursive;
      font-size: 26px;
      color: var(--chalk-yellow);
      text-align: right;
      margin-top: 12px;
    }

    .again-btn {
      margin-top: 6px;
    }

    @media (max-width:480px) {
      .board-inner {
        padding: 26px 14px 22px;
        min-height: 560px;
      }

      .grid {
        gap: 9px;
      }

      .stats {
        font-size: 15px;
        gap: 18px;
      }
    }

    .sound-toggle {
      position: absolute;
      top: 14px;
      right: 14px;
      z-index: 5;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px dashed rgba(246, 241, 230, .6);
      background: rgba(246, 241, 230, .06);
      color: var(--chalk-white);
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform .15s ease, background .2s ease;
    }

    .sound-toggle:hover,
    .sound-toggle:focus-visible {
      background: rgba(246, 241, 230, .14);
      transform: scale(1.06);
      outline: none;
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: .001s !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001s !important;
      }
    }
  </style>
</head>

<body>

  <!-- SVG filter used to give cards a hand-drawn chalk wobble -->
  <svg width="0" height="0" style="position:absolute">
    <filter id="roughen">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <div class="wood-frame">
    <div class="board-inner">

      <button class="sound-toggle" id="btn-sound" aria-label="Ativar ou desativar som" title="Som">🔊</button>

      <!-- ============ TELA 1: INTRODUÇÃO ============ -->
      <section id="screen-intro" class="screen active">
        <div class="doodles" aria-hidden="true">
          <span style="top:6%; left:8%;">📚</span>
          <span style="top:14%; right:10%; animation-delay:1s;">✏️</span>
          <span style="bottom:18%; left:12%; animation-delay:2s;">⭐</span>
          <span style="bottom:10%; right:8%; animation-delay:1.5s;">🍎</span>
          <span style="top:44%; left:4%; animation-delay:.6s;">🎓</span>
        </div>
        <div class="eyebrow">um joguinho especial que Marvio fez pra você</div>
        <h1 class="chalk-title">Feliz Aniversário,<br>Sabrina!</h1>
        <p class="subtitle">
          Professora que transforma qualquer sala em um lugar de encantamento.
          Encontre os pares escondidos no quadro e descubra uma surpresa no final. 🖍️
        </p>
        <button class="chalk-btn" id="btn-start">Começar o jogo 🍎</button>
      </section>

      <!-- ============ TELA 2: JOGO DA MEMÓRIA ============ -->
      <section id="screen-game" class="screen">
        <div class="eyebrow">encontre todos os pares</div>
        <h1 class="chalk-title" style="font-size:clamp(30px,6vw,42px); margin-bottom:14px;">O Quadro da Sabrina</h1>
        <div class="stats">
          <div>Pares: <b id="stat-pairs">0</b>/8</div>
          <div>Jogadas: <b id="stat-moves">0</b></div>
        </div>
        <div class="grid" id="grid"></div>
        <p class="hint">toque nas cartas para virar o giz ✨</p>
      </section>

      <!-- ============ TELA 3: PARABÉNS ============ -->
      <section id="screen-congrats" class="screen">
        <div class="confetti-layer" id="confetti-layer" aria-hidden="true"></div>
        <div class="cake">🎂</div>
        <h1 class="chalk-title">Parabéns,<br>Linda Sabrina!</h1>


        <div class="message-box">
          <p>
            Quero comemorar contigo mais um ano de vida e essa pequena homenagem é feita com muito carinho e
            sinceridade.
          </p>
          <p>Você está completando mais um ano de vida e tem vários motivos para comemorar essa data tão importante para
            você.</p>
          <p>
          <p>Em nossas memórias nós guardamos muita coisa, mas gostaria de lembrar que as melhores coisas da vida são
            aquelas que realmente nos fazem felizes.</p>
          <p>Espero que essa mensagem tenha arrancado risos e mais risos e te deixado pelo menos muito
            feliz por essa minha grata surpresa. </p>
          <p>O meu muito obrigado por você existir. Feliz aniversário! ♥️</p>


          </p>
          <div class="signature_over">Com carinho e admiração 🌹</div>
          <div class="signature">Marvio Rocha - 22/08/26 👋</div>
        </div>
        <!-- FIM DA ÁREA EDITÁVEL -->

        <button class="chalk-btn again-btn" id="btn-again">Jogar de novo 🔁</button>
      </section>

    </div>
  </div>

  <script>
    (function () {
      const ICONS = ['📚', '🍎', '✏️', '🎓', '📏', '🔔', '🧮', '🌟'];
      const deck = [...ICONS, ...ICONS];

      // ---------------- ÁUDIO ----------------
      // Todos os sons (efeitos + música) são sintetizados ao vivo via Web Audio API,
      // então o arquivo funciona sozinho, sem precisar de nenhum arquivo de música externo.
      let audioCtx = null;
      let masterGain = null;
      let muted = false;
      let musicEnabled = false;
      let musicTimer = null;

      function getCtx() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          masterGain = audioCtx.createGain();
          masterGain.gain.value = 1;
          masterGain.connect(audioCtx.destination);
        }
        return audioCtx;
      }

      function playTone(freq, start, duration, type, vol) {
        const ctx = getCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type || 'sine';
        osc.frequency.value = freq;
        const t0 = ctx.currentTime + start;
        gain.gain.setValueAtTime(0, t0);
        gain.gain.linearRampToValueAtTime(vol, t0 + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, t0 + duration);
        osc.connect(gain);
        gain.connect(masterGain);
        osc.start(t0);
        osc.stop(t0 + duration + 0.05);
      }

      function sfxFlip() { playTone(480, 0, 0.09, 'triangle', 0.10); }
      function sfxMatch() {
        playTone(523.25, 0, 0.14, 'sine', 0.14);
        playTone(659.25, 0.10, 0.20, 'sine', 0.14);
      }
      function sfxMismatch() {
        playTone(220, 0, 0.16, 'sine', 0.08);
        playTone(185, 0.09, 0.18, 'sine', 0.07);
      }
      function sfxWin() {
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => playTone(f, i * 0.12, 0.22, 'triangle', 0.13));
      }

      // Melodia de "Parabéns pra Você" (domínio público), tocada em loop na tela final.
      // [frequência em Hz, duração em tempos]
      const BEAT = 0.42;
      const MELODY = [
        [392.00, 0.75], [392.00, 0.25], [440.00, 1], [392.00, 1], [523.25, 1], [493.88, 2],
        [392.00, 0.75], [392.00, 0.25], [440.00, 1], [392.00, 1], [587.33, 1], [523.25, 2],
        [392.00, 0.75], [392.00, 0.25], [783.99, 1], [659.25, 1], [523.25, 1], [493.88, 1], [440.00, 2],
        [698.46, 0.75], [698.46, 0.25], [659.25, 1], [523.25, 1], [587.33, 1], [523.25, 2],
      ];

      function playMelodyOnce() {
        let t = 0;
        MELODY.forEach(([freq, dur]) => {
          playTone(freq, t, dur * BEAT * 0.92, 'sine', 0.085);
          t += dur * BEAT;
        });
        return t;
      }

      function startMusic() {
        if (musicEnabled) return;
        musicEnabled = true;
        const loop = () => {
          if (!musicEnabled) return;
          const total = playMelodyOnce();
          musicTimer = setTimeout(loop, total * 1000 + 700);
        };
        loop();
      }

      function stopMusic() {
        musicEnabled = false;
        clearTimeout(musicTimer);
      }

      const soundBtn = document.getElementById('btn-sound');
      soundBtn.addEventListener('click', () => {
        muted = !muted;
        if (masterGain) masterGain.gain.value = muted ? 0 : 1;
        soundBtn.textContent = muted ? '🔇' : '🔊';
        soundBtn.setAttribute('aria-label', muted ? 'Ativar som' : 'Desativar som');
      });

      const screens = {
        intro: document.getElementById('screen-intro'),
        game: document.getElementById('screen-game'),
        congrats: document.getElementById('screen-congrats'),
      };
      function showScreen(name) {
        Object.values(screens).forEach(s => s.classList.remove('active'));
        screens[name].classList.add('active');
      }

      const grid = document.getElementById('grid');
      const statPairs = document.getElementById('stat-pairs');
      const statMoves = document.getElementById('stat-moves');

      let flipped = [];
      let matchedCount = 0;
      let moves = 0;
      let lock = false;

      function shuffle(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
      }

      function buildGrid() {
        grid.innerHTML = '';
        flipped = [];
        matchedCount = 0;
        moves = 0;
        lock = false;
        statPairs.textContent = '0';
        statMoves.textContent = '0';

        const cards = shuffle([...deck]);
        cards.forEach((icon, idx) => {
          const card = document.createElement('div');
          card.className = 'card';
          card.setAttribute('tabindex', '0');
          card.setAttribute('role', 'button');
          card.setAttribute('aria-label', 'Carta virada para baixo');
          card.dataset.icon = icon;
          card.innerHTML = `
        <div class="card-inner">
          <div class="card-face card-back">?</div>
          <div class="card-face card-front">${icon}</div>
        </div>`;
          card.addEventListener('click', () => flipCard(card));
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flipCard(card); }
          });
          grid.appendChild(card);
        });
      }

      function flipCard(card) {
        if (lock) return;
        if (card.classList.contains('flipped') || card.classList.contains('matched')) return;
        if (flipped.length === 2) return;

        card.classList.add('flipped');
        flipped.push(card);
        sfxFlip();

        if (flipped.length === 2) {
          moves++;
          statMoves.textContent = moves;
          const [a, b] = flipped;
          if (a.dataset.icon === b.dataset.icon) {
            lock = true;
            sfxMatch();
            setTimeout(() => {
              a.classList.add('matched');
              b.classList.add('matched');
              matchedCount++;
              statPairs.textContent = matchedCount;
              flipped = [];
              lock = false;
              if (matchedCount === ICONS.length) {
                setTimeout(() => {
                  sfxWin();
                  showScreen('congrats');
                  launchConfetti();
                  setTimeout(startMusic, 500);
                }, 650);
              }
            }, 450);
          } else {
            lock = true;
            setTimeout(sfxMismatch, 350);
            setTimeout(() => {
              a.classList.remove('flipped');
              b.classList.remove('flipped');
              flipped = [];
              lock = false;
            }, 800);
          }
        }
      }

      document.getElementById('btn-start').addEventListener('click', () => {
        const ctx = getCtx();
        if (ctx.state === 'suspended') ctx.resume();
        buildGrid();
        showScreen('game');
      });

      document.getElementById('btn-again').addEventListener('click', () => {
        stopMusic();
        document.getElementById('confetti-layer').innerHTML = '';
        buildGrid();
        showScreen('game');
      });

      // ---- confetti (chalk sticks) ----
      const colors = ['#f0cf6c', '#f2a4b0', '#9fd3e8', '#f6f1e6'];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function launchConfetti() {
        const layer = document.getElementById('confetti-layer');
        const count = reduceMotion ? 12 : 45;
        for (let i = 0; i < count; i++) {
          setTimeout(() => {
            const c = document.createElement('div');
            c.className = 'confetti';
            const size = 5 + Math.random() * 7;
            c.style.left = Math.random() * 100 + '%';
            c.style.width = size + 'px';
            c.style.height = (size * 2.4) + 'px';
            c.style.background = colors[Math.floor(Math.random() * colors.length)];
            c.style.animationDuration = (2.6 + Math.random() * 1.8) + 's';
            layer.appendChild(c);
            setTimeout(() => c.remove(), 5000);
          }, i * 60);
        }
      }
    })();
  </script>

</body>

</html>
