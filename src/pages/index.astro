---
import { Image } from "astro:assets";
import Logo from "../assets/logo.svg";
---

<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<title>Redirecting...</title>
	</head>
	<body class="flex items-center justify-center h-screen">
		<div class="text-center">
			<Image src={Logo} alt="Logo" width={200} />
			<p class="mt-4 text-xl">Redirecionando para sua versão local...</p>
		</div>

		<script>
			// Função para detectar localização e redirecionar
			if (navigator.geolocation) {
				navigator.geolocation.getCurrentPosition(
					(position) => {
						// Aqui poderia usar API externa para detectar país via coordenadas
						// Mas para demo simples, vamos usar o idioma do navegador
						const lang =
							navigator.language || navigator.userLanguage;

						if (lang.startsWith("en")) {
							window.location.href = "/en";
						} else {
							window.location.href = "/pt-br";
						}
					},
					(error) => {
						// Caso usuário negue ou falhe — fallback pro idioma do navegador
						const lang =
							navigator.language || navigator.userLanguage;
						if (lang.startsWith("en")) {
							window.location.href = "/en";
						} else {
							window.location.href = "/pt-br";
						}
					},
				);
			} else {
				// Se geolocalização não disponível, usa idioma do navegador
				const lang = navigator.language || navigator.userLanguage;
				if (lang.startsWith("en")) {
					window.location.href = "/en";
				} else {
					window.location.href = "/pt-br";
				}
			}
		</script>
	</body>
</html>
