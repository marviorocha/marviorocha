---
import "../styles/global.css";
import { Image } from "astro:assets";
import Logo from "../assets/logo.svg";
---

<!doctype html>
<html class="scroll-smooth" data-theme="light" lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>
			Redirecting...
		</title>
	</head>
	<body>
		<div
			class="text-center flex flex-col items-center mx-auto justify-center h-screen"
		>
			<Image src={Logo} alt="Logo" width={300} height={200} />
			<p class="mt-4 text-xl">
				<span class="loading loading-infinity loading-lg"
				></span>Redirecionando para sua versão local...
			</p>
		</div>
		<script>
			// Função para detectar localização e redirecionar
			if (navigator.geolocation) {
				navigator.geolocation.getCurrentPosition(
					(position) => {
						// Aqui poderia usar API externa para detectar país via coordenadas
						// Mas para demo simples, vamos usar o idioma do navegador
						const lang =
							navigator.language || navigator.userLanguage;

						if (lang.startsWith("en")) {
							window.location.href = "/en";
						} else {
							window.location.href = "/pt-br";
						}
					},
					(error) => {
						// Caso usuário negue ou falhe — fallback pro idioma do navegador
						const lang =
							navigator.language || navigator.userLanguage;
						if (lang.startsWith("en")) {
							window.location.href = "/en";
						} else {
							window.location.href = "/pt-br";
						}
					},
				);
			} else {
				// Se geolocalização não disponível, usa idioma do navegador
				const lang = navigator.language || navigator.userLanguage;
				if (lang.startsWith("en")) {
					window.location.href = "/en";
				} else {
					window.location.href = "/pt-br";
				}
			}
		</script>
	</body>

	
</html>
