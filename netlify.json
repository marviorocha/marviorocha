{
    "plugins": [
        {
            "package": "@netlify/plugin-sitemap",
            "config": {
                "baseUrl": "https://marviorocha.com",
                "buildDir": "dist"
            }
        },
        {
            "package": "netlify-plugin-submit-sitemap",
            "config": {
                "baseUrl": "https://marviorocha.com",
                "sitemapPath": "/sitemap.xml"
            }
        },
        {
            "package": "netlify-plugin-cache",
            "config": {
                "cacheDirectories": [
                    "node_modules/.cache",
                    ".parcel-cache"
                ]
            }
        }
    ]
}